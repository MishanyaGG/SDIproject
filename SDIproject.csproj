<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Image\Cplusplus.png" />
    <None Remove="Assets\Image\PHP.png" />
    <None Remove="Assets\Image\Python.png" />
    <None Remove="Assets\Image\setting.png" />
    <None Remove="Python.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Image\Cplusplus.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Image\PHP.png" />
    <Resource Include="Assets\Image\Python.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Image\setting.png" />
  </ItemGroup>

</Project>
